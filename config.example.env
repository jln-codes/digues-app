# Copier ce modèle vers config.env : la CLI chargera automatiquement la copie.
# Ce fichier d'exemple n'est jamais chargé par la CLI et ne doit contenir aucun secret.

# Source CouchDB (profil local par défaut)
SIRS_PROFILE=local
SIRS_LOCAL_COUCHDB_URL=http://127.0.0.1:5984
SIRS_LOCAL_DATABASE=sirs_source
SIRS_LOCAL_USERNAME=
SIRS_LOCAL_PASSWORD=
SIRS_LOCAL_TIMEOUT=60

# Fallback CRS source, inutile si le document CouchDB $sirs est correctement renseigné.
# Accepte 2154 ou EPSG:2154.
SIRS_SOURCE_SRID=

# Exemple de profil sécurisé (valeurs volontairement non fonctionnelles)
SIRS_SECURE_COUCHDB_URL=https://couchdb.example.invalid
SIRS_SECURE_DATABASE=sirs_source
SIRS_SECURE_USERNAME=replace-me
SIRS_SECURE_PASSWORD=replace-me
SIRS_SECURE_TIMEOUT=60

# Cible PostgreSQL. Le DSN est prioritaire s'il est défini.
# SIRS_POSTGRE_DSN=postgresql://user:password@127.0.0.1:5432/sirs_postgre
SIRS_POSTGRE_HOST=127.0.0.1
SIRS_POSTGRE_PORT=5432
SIRS_POSTGRE_DATABASE=sirs_postgre
SIRS_POSTGRE_USER=postgres
SIRS_POSTGRE_PASSWORD=
SIRS_POSTGRE_CONNECT_TIMEOUT=10
SIRS_POSTGRE_ADMIN_DATABASE=postgres

# Assistant IA web (laisser vide dans cet exemple et définir la vraie clé hors Git).
MISTRAL_API_KEY=
